{
  "info": {
    "name": "Crystal Ball Command Centre - backend",
    "description": "All backend checks from the assignment (Postman Tests 1-11).\n\nVariables:\n- baseUrl: gateway URL including the /api prefix (default http://localhost:4000/api)\n- expectedSource: leave empty to accept ai or fallback; set to ai for a strict happy-path run, or to fallback when running against `npm run demo:fail` (Test 11).\n\nRun the whole collection normally, then again with expectedSource=fallback while the AI service runs with `npm run demo:fail`. To run the rate-limit test (Test 4), run only the '4. Rate limiting' folder with 11 iterations and no delay.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api"
    },
    {
      "key": "expectedSource",
      "value": ""
    },
    {
      "key": "rlSession",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Approvals (Test 1)",
      "item": [
        {
          "name": "GET /approvals",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('Returns an array of 4 approvals', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.be.an('array').with.lengthOf(4);",
                  "});",
                  "pm.test('Every item has id, title, type, submittedBy, status, submittedDate', () => {",
                  "  pm.response.json().forEach((item) => {",
                  "    ['id', 'title', 'type', 'submittedBy', 'status', 'submittedDate'].forEach((key) => {",
                  "      pm.expect(item).to.have.property(key).that.is.a('string').and.not.empty;",
                  "    });",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/approvals",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "approvals"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Summary (Tests 2 and 3)",
      "item": [
        {
          "name": "POST /summary",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('headline is a string and items has 4 entries with a valid urgency', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.headline).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.items).to.have.lengthOf(4);",
                  "  body.items.forEach((item) => {",
                  "    pm.expect(['high', 'medium', 'low']).to.include(item.urgency);",
                  "    pm.expect(item.id).to.be.a('string');",
                  "    pm.expect(item.reason).to.be.a('string').and.not.empty;",
                  "  });",
                  "});",
                  "",
                  "const expected = pm.variables.get('expectedSource');",
                  "pm.test(expected ? `source is \"${expected}\"` : 'source is \"ai\" or \"fallback\"', () => {",
                  "  const source = pm.response.json().source;",
                  "  if (expected) { pm.expect(source).to.eql(expected); }",
                  "  else { pm.expect(['ai', 'fallback']).to.include(source); }",
                  "});",
                  "",
                  "pm.test('Fallback ranks the safety-critical item first', () => {",
                  "  const body = pm.response.json();",
                  "  if (body.source === 'fallback') { pm.expect(body.items[0].id).to.eql('apr-3'); }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-session-id",
                "value": "pm-summary"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/summary",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "summary"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Test 2 (success) as-is. Test 3 (fallback): put a wrong COHERE_API_KEY in ai-assistant-service/.env, restart it and send the same request."
          }
        }
      ]
    },
    {
      "name": "3. Greeting (Test 5)",
      "item": [
        {
          "name": "POST /greeting",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('text is a non-empty string', () => {",
                  "  pm.expect(pm.response.json().text).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "const expected = pm.variables.get('expectedSource');",
                  "pm.test(expected ? `source is \"${expected}\"` : 'source is \"ai\" or \"fallback\"', () => {",
                  "  const source = pm.response.json().source;",
                  "  if (expected) { pm.expect(source).to.eql(expected); }",
                  "  else { pm.expect(['ai', 'fallback']).to.include(source); }",
                  "});",
                  "",
                  "pm.test('Mentions the 4 pending items (or exactly the fallback sentence)', () => {",
                  "  const body = pm.response.json();",
                  "  if (body.source === 'fallback') {",
                  "    pm.expect(body.text).to.eql('You have 4 approvals pending.');",
                  "  } else {",
                  "    pm.expect(body.text.toLowerCase()).to.match(/\\b(4|four)\\b/);",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-session-id",
                "value": "pm-greeting"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/greeting",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "greeting"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Send it twice: the AI wording should differ each time."
          }
        }
      ]
    },
    {
      "name": "4. Rate limiting (Test 4) - run this folder with 11 iterations",
      "item": [
        {
          "name": "POST /greeting (same session, 11 times)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.info.iteration === 0) { pm.collectionVariables.set('rlSession', 'rl-' + Date.now()); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const i = pm.info.iteration;",
                  "if (i < 10) {",
                  "  pm.test(`Request ${i + 1} is allowed (200)`, () => pm.response.to.have.status(200));",
                  "} else {",
                  "  pm.test(`Request ${i + 1} is rate limited (429)`, () => pm.response.to.have.status(429));",
                  "  pm.test('429 body is JSON { error, code: RATE_LIMITED }', () => {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.code).to.eql('RATE_LIMITED');",
                  "    pm.expect(body.error).to.be.a('string').and.not.empty;",
                  "  });",
                  "  pm.test('Retry-After header is present', () => {",
                  "    pm.expect(Number(pm.response.headers.get('Retry-After'))).to.be.above(0);",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-session-id",
                "value": "{{rlSession}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/greeting",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "greeting"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Collection Runner: select only this folder, Iterations = 11, Delay = 0. Requests 1-10 return 200, request 11 returns 429."
          }
        },
        {
          "name": "POST /greeting (a different session is not affected)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('A new x-session-id is still allowed (200)', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-session-id",
                "value": "rl-other-{{$randomUUID}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/greeting",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "greeting"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "GET /approvals (never rate limited)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
