    {
      "name": "6. Chat - SSE (Tests 8, 8b, 8c)",
      "item": [
        {
          "name": "POST /chat - talk (Test 8)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "const frames = pm.response.text().split('\\n\\n').filter(Boolean);",
                  "const events = frames.map((f) => ({",
                  "  event: (/^event: (.+)$/m.exec(f) || [])[1],",
                  "  data: (/^data: (.+)$/m.exec(f) || [])[1],",
                  "}));",
                  "const names = events.map((e) => e.event);",
                  "",
                  "const expected = pm.variables.get('expectedSource');",
                  "pm.test('Content-Type is text/event-stream', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('text/event-stream');",
                  "});",
                  "pm.test('Cache-Control is no-cache', () => {",
                  "  pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-cache');",
                  "});",
                  "pm.test('The stream ends with a done or an error event', () => {",
                  "  pm.expect(['done', 'error']).to.include(names[names.length - 1]);",
                  "});",
                  "if (expected === 'fallback') {",
                  "  pm.test('LLM failure: a friendly error event and no tokens', () => {",
                  "    pm.expect(names).to.eql(['error']);",
                  "    const message = JSON.parse(events[0].data).message;",
                  "    pm.expect(message).to.be.a('string').and.not.empty;",
                  "    pm.expect(message).to.not.match(/401|ECONN|api|token|key/i);",
                  "  });",
                  "} else {",
                  "  pm.test('Token events arrive, then done', () => {",
                  "    if (expected === 'ai' || names.includes('token')) {",
                  "      pm.expect(names.filter((n) => n === 'token').length).to.be.above(0);",
                  "      pm.expect(names[names.length - 1]).to.eql('done');",
                  "    } else {",
                  "      pm.expect(names).to.eql(['error']); // LLM was slow: friendly error, closed cleanly",
                  "    }",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-session-id",
                "value": "pm-chat-1"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"pm-1\",\n  \"mode\": \"talk\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Which approval needs my attention first and why?\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Postman may show the stream all at once; use `curl -N` to watch tokens arrive gradually."
          }
        },
